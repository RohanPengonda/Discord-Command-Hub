# Render sets NODE_ENV=production, which makes npm default to omit=dev.
# The server's build toolchain (typescript, @types/node, @types/express) lives in
# devDependencies, so without this the Render build fails with TS2580 "Cannot find
# name 'process'" and TS7016 on express. This must live at the workspace root;
# npm ignores .npmrc files inside workspace directories.
# Install-time only, has no effect on the runtime bundle.
include=dev
